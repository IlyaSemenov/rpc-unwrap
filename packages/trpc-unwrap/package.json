  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@rpc-unwrap/core": "workspace:*",
    "@trpc/server": "11.28.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.4",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@trpc/server": "^11.0.0"
  }
}
