{
  "name": "trpc-unwrap",
  "version": "0.0.0",
  "description": "Convert domain errors returned as values into tRPC errors.",
  "homepage": "https://github.com/IlyaSemenov/rpc-unwrap/tree/main/packages/trpc-unwrap#readme",
  "bugs": "https://github.com/IlyaSemenov/rpc-unwrap/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/rpc-unwrap.git",
    "directory": "packages/trpc-unwrap"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
