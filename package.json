{
  "name": "rpc-unwrap-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "release": "changesets-release",
    "test": "bun run --workspaces --if-present test",
    "types": "bun run --workspaces --if-present types"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "changesets-release": "^2.1.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7"
  },
  "packageManager": "bun@1.4.4"
}
